---
import type { Props } from './types';

const { title, description, canonical, ogType = 'website', jsonLd = [], author, dateModified } = Astro.props;

const SITE = 'https://worldbatteryhub.com';
const BRAND = 'World Battery Hub';
const fullTitle = title.includes('World Battery Hub') ? title : `${title} | ${BRAND}`;
const resolvedDescription = description || 'A battery knowledge and data platform — lead-acid and lithium battery specifications, technology, testing, manufacturers and market data.';

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE}/#organization`,
  name: BRAND,
  url: SITE,
  description: 'Battery knowledge and data platform covering lead-acid and lithium batteries — specifications, technology, testing, manufacturers and market intelligence.',
};

const pageJsonLd = jsonLd.map((item) => {
  const enriched = { '@context': 'https://schema.org', ...item };
  if (enriched['@type'] === 'Article' || enriched['@type'] === 'TechArticle') {
    return { ...enriched, author: { '@type': 'Organization', name: 'World Battery Hub Research Desk', url: `${SITE}/about/#research-desk` } };
  }
  return enriched;
});

const pageUrl = canonical ? `${SITE}${canonical}` : SITE;

const webSiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE}/#website`,
  url: SITE,
  name: BRAND,
  publisher: { '@id': `${SITE}/#organization` },
};

const webPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: fullTitle,
  publisher: { '@id': `${SITE}/#organization` },
  isPartOf: { '@id': `${SITE}/#website` },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: title, item: pageUrl },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#0d1e3c" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <title>{fullTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <link rel="canonical" href={canonical ? `${SITE}${canonical}` : SITE} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical ? `${SITE}${canonical}` : SITE} />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:image" content={`${SITE}/images/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${SITE}/images/og-image.png`} />
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(webSiteJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(webPageJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    {pageJsonLd.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <style is:global>
      /* World Battery Hub — global editorial theme
         Blue identity (#1d4ed8 family) on navy header/footer, light surfaces,
         generous article rhythm, refined tables, cards and callouts. */

      /* Breadcrumb (matches BreadcrumbList schema) */
      .breadcrumbs {
        padding: 14px 0 0;
        color: var(--muted, #64748b);
        font-size: 0.8rem;
        font-weight: 600;
      }

      .breadcrumbs .container {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
      }

      .breadcrumbs a {
        color: var(--accent);
        text-decoration: none;
      }

      .breadcrumbs a:hover {
        text-decoration: underline;
      }

      .breadcrumbs span[aria-hidden] {
        color: var(--accent-border);
      }

      :root {
        /* Brand */
        --accent: #1d4ed8;
        --accent-strong: #1e40af;
        --accent-deep: #16308c;
        --accent-soft: #e8f0ff;
        --accent-border: #c7d8fb;
        --accent-glow: rgba(29, 78, 216, 0.15);
        --sky: #7dd3fc;

        /* Surfaces */
        --navy: #0f1f3d;
        --navy-2: #17315f;
        --navy-deep: #0b1830;
        --bg: #f5f7fa;
        --surface: #ffffff;
        --surface-soft: #eef3f9;
        --surface-tint: #f8fafc;

        /* Text */
        --ink: #101b30;
        --body: #2e3c52;
        --muted: #64748b;
        --muted-strong: #475569;

        /* Lines */
        --border: #e2e8f0;
        --border-strong: #cbd5e1;
        --hairline: #edf1f6;

        /* Status */
        --warn-bg: #fffbeb;
        --warn-border: #fcd34d;
        --warn-ink: #92400e;

        /* Elevation */
        --shadow-sm: 0 1px 2px rgba(15, 31, 61, 0.05), 0 2px 6px rgba(15, 31, 61, 0.04);
        --shadow-md: 0 12px 28px rgba(15, 31, 61, 0.1), 0 2px 6px rgba(15, 31, 61, 0.06);
        --shadow-lg: 0 24px 48px rgba(15, 31, 61, 0.14);

        /* Shape */
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;

        /* Layout */
        --content-width: 900px;
        --header-width: 1120px;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        scroll-padding-top: 96px;
        text-size-adjust: 100%;
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(1100px 420px at 50% -180px, rgba(29, 78, 216, 0.07), transparent 70%),
          var(--bg);
        color: var(--body);
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        font-size: 16px;
        line-height: 1.7;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -webkit-tap-highlight-color: rgba(29, 78, 216, 0.12);
      }

      ::selection {
        background: rgba(29, 78, 216, 0.18);
        color: var(--ink);
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }

      img {
        max-width: 100%;
        height: auto;
      }

      .skip-link {
        position: fixed;
        top: -100px;
        left: 16px;
        z-index: 200;
        padding: 10px 16px;
        background: var(--surface);
        color: var(--accent-strong);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-sm);
        font-size: 0.9rem;
        font-weight: 700;
        text-decoration: none;
        box-shadow: var(--shadow-md);
        transition: top 160ms ease;
      }

      .skip-link:focus {
        top: 16px;
      }

      .container {
        width: min(100% - 40px, var(--content-width));
        margin-inline: auto;
      }

      .section {
        padding: 48px 0 72px;
      }

      main {
        display: block;
        min-height: 62vh;
      }

      /* Header */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: linear-gradient(135deg, var(--navy-deep) 0%, var(--navy) 45%, var(--navy-2) 100%);
        box-shadow: 0 8px 24px rgba(11, 24, 48, 0.18);
      }

      .site-header::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, rgba(125, 211, 252, 0.7) 30%, rgba(125, 211, 252, 0.7) 70%, transparent);
      }

      .site-header .container {
        width: min(100% - 40px, var(--header-width));
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 14px 0;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: #ffffff;
        font-size: 1.1rem;
        font-weight: 800;
        letter-spacing: -0.015em;
        line-height: 1.2;
        text-decoration: none;
        white-space: nowrap;
      }

      .brand-logo {
        flex: 0 0 auto;
        border-radius: 6px;
        padding: 2px;
        background: rgba(255, 255, 255, 0.06);
      }

      .nav {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 2px;
        overflow-x: auto;
        scrollbar-width: none;
      }

      .nav::-webkit-scrollbar {
        display: none;
      }

      .nav a {
        color: #cfdff2;
        font-size: 0.88rem;
        font-weight: 600;
        line-height: 1.2;
        padding: 8px 12px;
        border-radius: var(--radius-sm);
        text-decoration: none;
        white-space: nowrap;
        transition: background-color 140ms ease, color 140ms ease;
      }

      .nav a:hover {
        background: rgba(255, 255, 255, 0.12);
        color: #ffffff;
      }

      .nav a:focus-visible {
        outline-color: #93c5fd;
      }

      /* Article typography */
      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        color: var(--navy);
        line-height: 1.22;
        text-wrap: balance;
        overflow-wrap: break-word;
      }

      h1 {
        position: relative;
        margin: 0 0 22px;
        padding-bottom: 18px;
        font-size: clamp(2.05rem, 4.2vw + 0.5rem, 2.75rem);
        font-weight: 800;
        letter-spacing: -0.032em;
        line-height: 1.14;
      }

      h1::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: 0;
        width: 68px;
        height: 4px;
        border-radius: 2px;
        background: linear-gradient(90deg, var(--accent), #93bdf5);
      }

      h2 {
        margin: 46px 0 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--hairline);
        font-size: clamp(1.42rem, 1.4vw + 0.95rem, 1.72rem);
        font-weight: 700;
        letter-spacing: -0.018em;
        scroll-margin-top: 92px;
      }

      h2::before {
        content: "";
        display: block;
        width: 36px;
        height: 3px;
        margin: 0 0 12px;
        border-radius: 2px;
        background: linear-gradient(90deg, var(--accent), var(--accent-soft));
      }

      h3 {
        margin: 32px 0 10px;
        font-size: 1.17rem;
        font-weight: 700;
        letter-spacing: -0.012em;
        scroll-margin-top: 88px;
      }

      h4 {
        margin: 24px 0 8px;
        font-size: 1.02rem;
        font-weight: 700;
        scroll-margin-top: 88px;
      }

      h5,
      h6 {
        margin: 22px 0 8px;
        font-weight: 700;
        scroll-margin-top: 88px;
      }

      p {
        margin: 0 0 1.15em;
      }

      strong {
        color: var(--ink);
        font-weight: 700;
      }

      .lead {
        margin: 0 0 28px;
        padding: 2px 0 2px 18px;
        border-left: 4px solid var(--accent);
        color: #38475f;
        font-size: 1.13rem;
        line-height: 1.72;
      }

      .byline {
        margin: 0 0 14px;
        color: var(--muted-strong);
        font-size: 0.72rem;
        font-weight: 750;
        letter-spacing: 0.09em;
        line-height: 1.5;
        text-transform: uppercase;
        font-variant-numeric: tabular-nums;
      }

      .byline::before {
        content: "";
        display: inline-block;
        vertical-align: middle;
        width: 16px;
        height: 2px;
        margin-right: 9px;
        border-radius: 1px;
        background: var(--accent);
      }

      .muted {
        color: var(--muted);
        font-size: 0.87rem;
        line-height: 1.6;
      }

      /* 页脚「政策与合规」链接行 */
      .site-footer nav.muted {
        margin: 0.6rem 0;
        line-height: 1.9;
      }

      a {
        color: var(--accent);
        text-decoration: underline;
        text-decoration-color: rgba(29, 78, 216, 0.3);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
        transition: color 140ms ease, text-decoration-color 140ms ease;
      }

      a:hover {
        color: var(--accent-strong);
        text-decoration-color: currentColor;
      }

      /* Inline technical content */
      code,
      kbd,
      samp {
        border: 1px solid #dbe6f5;
        border-radius: 5px;
        background: #eef3f9;
        padding: 0.14em 0.4em;
        color: #1d3f9e;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
        font-size: 0.86em;
      }

      pre {
        margin: 24px 0;
        padding: 18px 20px;
        overflow-x: auto;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: var(--radius-md);
        background: var(--navy-deep);
        color: #dbe7f7;
        font-size: 0.88rem;
        line-height: 1.65;
        box-shadow: var(--shadow-sm);
      }

      pre code {
        border: 0;
        background: transparent;
        padding: 0;
        color: inherit;
        font-size: inherit;
      }

      blockquote {
        margin: 24px 0;
        padding: 16px 20px;
        border-left: 4px solid var(--accent);
        border-radius: 0 var(--radius-md) var(--radius-md) 0;
        background: var(--surface-soft);
        color: var(--muted-strong);
      }

      blockquote > :first-child {
        margin-top: 0;
      }

      blockquote > :last-child {
        margin-bottom: 0;
      }

      hr {
        height: 1px;
        margin: 32px 0;
        border: 0;
        background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
      }

      /* Lists */
      ul,
      ol {
        margin: 0 0 1.3em;
        padding-left: 1.5em;
      }

      li {
        margin: 0.45em 0;
      }

      li > ul,
      li > ol {
        margin-top: 0.45em;
        margin-bottom: 0.45em;
      }

      ul {
        list-style: disc;
      }

      ul ul {
        list-style: circle;
      }

      ul ul ul {
        list-style: square;
      }

      ol {
        list-style: decimal;
      }

      li::marker {
        color: var(--accent);
        font-weight: 700;
      }

      dl {
        margin: 0 0 1.4em;
      }

      /* FAQ and open/close content */
      details {
        margin: 18px 0;
        padding: 16px 18px;
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        background: var(--surface);
        box-shadow: var(--shadow-sm);
        transition: border-color 140ms ease;
      }

      details[open] {
        border-color: var(--accent-border);
      }

      summary {
        cursor: pointer;
        color: var(--navy);
        font-weight: 700;
        transition: color 140ms ease;
      }

      summary:hover {
        color: var(--accent-strong);
      }

      summary::marker {
        color: var(--accent);
        font-size: 0.9em;
      }

      details[open] summary {
        margin-bottom: 10px;
      }

      .faq-item {
        margin-bottom: 20px;
      }

      .faq-item h3 {
        margin-bottom: 6px;
      }

      /* Callout / direct-answer boxes */
      .takeaways {
        margin: 26px 0;
        padding: 20px 22px 18px;
        border: 1px solid var(--accent-border);
        border-left: 4px solid var(--accent);
        border-radius: var(--radius-md);
        background: linear-gradient(135deg, #f0f5ff 0%, #fbfdff 100%);
        box-shadow: var(--shadow-sm);
      }

      .takeaways > :first-child {
        margin-top: 0;
      }

      .takeaways > :last-child {
        margin-bottom: 0;
      }

      .takeaways strong {
        color: var(--navy);
      }

      .takeaways ul,
      .takeaways ol {
        margin-bottom: 0;
      }

      /* Neutral side-note box */
      .box {
        margin: 24px 0;
        padding: 18px 20px 16px;
        border: 1px solid var(--border);
        border-left: 4px solid var(--border-strong);
        border-radius: var(--radius-md);
        background: var(--surface-tint);
      }

      .box > :first-child {
        margin-top: 0;
      }

      .box > :last-child {
        margin-bottom: 0;
      }

      /* Evidence / sourced-note box */
      .evidence {
        margin: 24px 0;
        padding: 18px 20px 16px;
        border: 1px dashed var(--border-strong);
        border-radius: var(--radius-md);
        background: #fbfcfe;
      }

      .evidence > :first-child {
        margin-top: 0;
      }

      .evidence > :last-child {
        margin-bottom: 0;
      }

      .evidence strong {
        color: var(--navy);
      }

      /* Comparison tables */
      table {
        display: block;
        width: 100%;
        margin: 26px 0;
        overflow-x: auto;
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        border-collapse: separate;
        border-spacing: 0;
        background: var(--surface);
        box-shadow: var(--shadow-sm);
        font-variant-numeric: tabular-nums lining-nums;
        font-size: 0.93rem;
        line-height: 1.55;
        -webkit-overflow-scrolling: touch;
      }

      caption {
        padding: 12px 16px 10px;
        border-bottom: 1px solid var(--hairline);
        color: var(--muted);
        font-size: 0.8rem;
        text-align: left;
      }

      th,
      td {
        padding: 12px 16px;
        border-bottom: 1px solid var(--hairline);
        text-align: left;
        vertical-align: top;
      }

      thead th {
        background: linear-gradient(180deg, #14294e, var(--navy));
        border-bottom: 2px solid var(--accent);
        color: #ffffff;
        font-size: 0.7rem;
        font-weight: 750;
        letter-spacing: 0.07em;
        line-height: 1.4;
        padding: 13px 16px;
        text-transform: uppercase;
        white-space: nowrap;
      }

      tbody th {
        background: #f4f7fb;
        color: var(--navy);
        font-weight: 700;
      }

      tbody tr:last-child th,
      tbody tr:last-child td {
        border-bottom: 0;
      }

      tbody tr:nth-child(even) td {
        background: #fafbfd;
      }

      tbody tr:nth-child(even) th {
        background: #eef3f9;
      }

      tbody tr:hover td {
        background: #eef4ff;
      }

      tbody tr:hover th {
        background: #e2ecfd;
      }

      table a {
        white-space: normal;
      }

      /* Cards */
      .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin: 26px 0;
      }

      .card {
        position: relative;
        padding: 22px 22px 20px;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        background: var(--surface);
        box-shadow: var(--shadow-sm);
        transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
      }

      .card::before {
        content: "";
        position: absolute;
        top: -1px;
        left: -1px;
        right: -1px;
        height: 3px;
        border-radius: var(--radius-lg) var(--radius-lg) 0 0;
        background: linear-gradient(90deg, var(--accent), #60a5fa);
        opacity: 0;
        transition: opacity 160ms ease;
      }

      .card:hover {
        border-color: var(--accent-border);
        box-shadow: var(--shadow-md);
        transform: translateY(-3px);
      }

      .card:hover::before {
        opacity: 1;
      }

      .card h3 {
        margin: 0 0 10px;
        font-size: 1.08rem;
        letter-spacing: -0.01em;
      }

      .card h3 a {
        color: var(--navy);
        text-decoration: none;
      }

      .card h3 a:hover {
        color: var(--accent-strong);
        text-decoration: underline;
      }

      .card p {
        margin: 0;
        color: var(--muted-strong);
        font-size: 0.93rem;
        line-height: 1.6;
      }

      /* Buttons / CTAs */
      .cta,
      .cta-outline {
        display: inline-block;
        padding: 11px 20px;
        border-radius: var(--radius-sm);
        font-size: 0.92rem;
        font-weight: 700;
        line-height: 1.2;
        text-decoration: none;
        transition: background-color 140ms ease, border-color 140ms ease, color 140ms ease, transform 140ms ease, box-shadow 140ms ease;
      }

      .cta {
        background: var(--accent);
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(29, 78, 216, 0.25);
      }

      .cta:hover {
        background: var(--accent-strong);
        color: #ffffff;
        text-decoration: none;
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(29, 78, 216, 0.3);
      }

      .cta-outline {
        border: 1px solid var(--accent);
        color: var(--accent);
      }

      .cta-outline:hover {
        background: var(--accent-soft);
        color: var(--accent-strong);
        text-decoration: none;
      }

      /* Editorial note */
      .tech-review {
        margin-top: 44px;
        padding-top: 18px;
        border-top: 1px dashed var(--border-strong);
        color: var(--muted);
        font-size: 0.85rem;
        line-height: 1.6;
      }

      /* Footer */
      .site-footer {
        margin-top: 72px;
        padding: 44px 0 48px;
        border-top: 4px solid var(--accent);
        background: linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 100%);
        color: #d4e0ee;
      }

      .site-footer .container {
        width: min(100% - 40px, var(--header-width));
      }

      .site-footer p {
        margin: 0 0 10px;
        max-width: 78ch;
        font-size: 0.88rem;
        line-height: 1.7;
      }

      .site-footer p:last-child {
        margin-bottom: 0;
      }

      .site-footer a {
        color: #bcd3ff;
        text-decoration: underline;
        text-decoration-color: rgba(188, 211, 255, 0.4);
        text-underline-offset: 0.18em;
      }

