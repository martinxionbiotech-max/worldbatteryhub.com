const canonical = '/technology/series-vs-parallel/';

const articleJsonLd = {
  '@type': 'TechArticle',
  '@id': `https://worldbatteryhub.com${canonical}#article`,
  headline: title,
  url: `https://worldbatteryhub.com${canonical}`,
  inLanguage: 'en',
  about: 'Batteries in series vs parallel',
  articleSection: 'Battery Technology',
  dateModified: '2026-09-16',
  isPartOf: { '@id': 'https://worldbatteryhub.com/#website' },
};

const faqJsonLd = {
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the difference between series and parallel batteries?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Series adds voltage: two 12V batteries wired in series make 24V at the same capacity. Parallel adds capacity: two 100Ah batteries wired in parallel make 200Ah at the same voltage. Series changes the voltage; parallel changes the amp-hours.',
