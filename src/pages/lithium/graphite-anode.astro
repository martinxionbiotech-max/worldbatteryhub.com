const faqJsonLd = {
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Why is graphite still the standard anode?', acceptedAnswer: { '@type': 'Answer', text: 'Graphite pairs low and flat voltage with low cost, long cycle life and a mature supply chain — silicon holds more lithium but swells, cracks and costs more, so graphite remains the anode workhorse while silicon is blended in small shares.' } },
    { '@type': 'Question', name: 'How much graphite is in a lithium battery?', acceptedAnswer: { '@type': 'Answer', text: 'Roughly 1–1.2 kg of anode graphite per kWh of cell capacity is a commonly cited working figure, so a 60 kWh EV pack contains on the order of 60–70 kg — the anode is one of the battery\'s largest single-material masses.' } },
