          <tr><td><a href="https://testing.worldbatteryhub.com/c-rate-testing/">C-rate testing</a></td><td>Performance at high discharge rates</td><td>IEC 62660, IEC 61960</td></tr>
          <tr><td><a href="https://testing.worldbatteryhub.com/cycle-safety/">Cycle testing</a></td><td>Capacity retention over charge/discharge cycles</td><td>IEC 62660, IEC 61427</td></tr>
          <tr><td><a href="https://testing.worldbatteryhub.com/degradation-testing/">Degradation testing</a></td><td>Capacity and resistance drift over life</td><td>IEC 62660, IEC 61427</td></tr>
          <tr><td><a href="https://testing.worldbatteryhub.com/self-discharge-testing/">Self-discharge testing</a></td><td>Charge lost while standing</td><td>IEC / manufacturer method</td></tr>
          <tr><td><a href="https://testing.worldbatteryhub.com/abuse-testing/">Abuse testing</a></td><td>Safety limits under overcharge/overheat/crush</td><td>UN 38.3, UL 1973, SAE J2464</td></tr>
          <tr><td><a href="https://testing.worldbatteryhub.com/short-circuit-testing/">Short-circuit testing</a></td><td>Behaviour under an external short</td><td>UN 38.3, IEC 62133</td></tr>
