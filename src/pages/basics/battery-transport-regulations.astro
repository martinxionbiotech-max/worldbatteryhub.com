const faqJsonLd = {
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Are batteries dangerous goods for transport?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, in almost every case. Wet (filled) lead-acid batteries are Class 8 corrosive dangerous goods; lithium batteries are Class 9 miscellaneous dangerous goods. Both travel under UN numbers, packaging rules and carrier restrictions — shipping a battery without the correct classification and paperwork is a compliance breach, not a detail.',
      },
    },
