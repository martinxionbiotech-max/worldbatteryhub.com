  '@type': 'Article',
  '@id': `https://worldbatteryhub.com${canonical}#article`,
  headline: title,
  url: `https://worldbatteryhub.com${canonical}`,
  inLanguage: 'en',
  about: title,
  articleSection: 'Battery Basics — Advanced',
  dateModified: '2026-09-17',
  isPartOf: { '@id': 'https://worldbatteryhub.com/#website' },
};

const faqJsonLd = {
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How big should a marine house bank be?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Energy first: 100W for 8 hours is 800 Wh, which at 12V is about 67 Ah usable — roughly 134 Ah rated for lead-acid's 50% window, typically a pair of Group 27 deep-cycles or a single 130–150 Ah deep-cycle.",
