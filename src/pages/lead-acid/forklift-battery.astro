---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Forklift Battery: Motive Power Explained (Lead-Acid vs…';
const description = 'Forklift batteries are deep-cycle motive power batteries — deep-discharged daily, recharged nightly. Lead-acid vs lithium for forklifts, and what drives the shift.';
const canonical = '/lead-acid/forklift-battery/';

const articleJsonLd = {
  '@type': 'Article',
  '@id': `https://worldbatteryhub.com${canonical}#article`,
  headline: title,
  url: `https://worldbatteryhub.com${canonical}`,
  inLanguage: 'en',
  about: 'Forklift battery',
  articleSection: 'Lead-Acid Battery Knowledge',
  dateModified: '2026-09-16',
  isPartOf: { '@id': 'https://worldbatteryhub.com/#website' },
};

const faqJsonLd = {
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What kind of battery does a forklift use?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Forklifts use deep-cycle motive-power batteries — traditionally large flooded lead-acid cells, now increasingly lithium (LFP). Both are built for deep daily discharge followed by a full recharge, unlike a car starting battery.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is lithium better than lead-acid for forklifts?',
      acceptedAnswer: {
