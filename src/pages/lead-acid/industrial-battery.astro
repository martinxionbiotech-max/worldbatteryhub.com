const canonical = '/lead-acid/industrial-battery/';

const articleJsonLd = {
  '@type': 'Article',
  '@id': `https://worldbatteryhub.com${canonical}#article`,
  headline: title,
  url: `https://worldbatteryhub.com${canonical}`,
  inLanguage: 'en',
  about: 'Industrial battery',
  articleSection: 'Lead-Acid Battery Knowledge',
  dateModified: '2026-09-16',
  isPartOf: { '@id': 'https://worldbatteryhub.com/#website' },
};

const faqJsonLd = {
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is an industrial battery?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'It is a battery built for heavy professional duty — forklift motive power, UPS standby and stationary storage — typically large flooded or sealed lead-acid cells, with lithium increasingly taking the cycling applications.',
      },
    },
    {
      '@type': 'Question',
