const canonical = '/lead-acid/start-stop-battery/';

const articleJsonLd = {
  '@type': 'Article',
  '@id': `https://worldbatteryhub.com${canonical}#article`,
  headline: title,
  url: `https://worldbatteryhub.com${canonical}`,
  inLanguage: 'en',
