const faqJsonLd = {
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What battery does a start-stop car need?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'An EFB or AGM battery, depending on what the manufacturer specified. Start-stop systems cycle the battery hundreds of times a drive, which a conventional flooded battery cannot survive — so replacing with the specified EFB/AGM technology is essential.',
