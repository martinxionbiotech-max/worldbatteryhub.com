const description = 'Typical cold cranking amps (CCA) by battery group size — H4/H5/H6/H7/H8/H9, L1–L6, JIS N-series and BCI Group 31/8D — and why CCA scales with group size but varies by design and standard.';
const canonical = '/lead-acid/cca/cca-by-battery-group/';

const articleJsonLd = {
