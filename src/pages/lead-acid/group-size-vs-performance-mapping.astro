            <td>Heavy industrial / large marine</td>
          </tr>
          <tr>
            <td><strong><a href="/lead-acid/gc2-battery/">GC2</a></strong></td>
            <td>6V, 264 × 183 mm</td>
            <td>~215 Ah (6V)</td>
