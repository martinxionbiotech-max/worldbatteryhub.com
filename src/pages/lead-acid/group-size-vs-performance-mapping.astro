            <td>~700</td>
            <td>Marine / RV dual-purpose</td>
          </tr>
          <tr>
            <td><strong>Group 27</strong></td>
            <td>306 × 173 mm</td>
            <td>~90–95 Ah</td>
            <td>~800</td>
            <td>Marine / RV / trucks</td>
          </tr>
          <tr>
            <td><strong><a href="/lead-acid/group-31-battery/">Group 31</a></strong></td>
            <td>330 × 173 mm</td>
            <td>~100 Ah</td>
            <td>~900</td>
            <td>Heavy-duty trucks, marine, off-grid</td>
          </tr>
          <tr>
