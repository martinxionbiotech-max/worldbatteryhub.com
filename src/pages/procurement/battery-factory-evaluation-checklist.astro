const canonical = '/procurement/battery-factory-evaluation-checklist/';

const articleJsonLd = {
  '@type': 'Article',
  '@id': `https://worldbatteryhub.com${canonical}#article`,
  headline: title,
  url: `https://worldbatteryhub.com${canonical}`,
  inLanguage: 'en',
  about: 'Evaluating and auditing battery factories before purchase commitment',
  articleSection: 'Procurement',
  author: { '@type': 'Organization', name: 'World Battery Hub Research Desk' },
  datePublished: '2026-09-22',
  dateModified: '2026-09-22',
  isPartOf: { '@id': 'https://worldbatteryhub.com/#website' },
};

const faqJsonLd = {
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Why audit a battery factory before ordering?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Because datasheets and quotations are promises, and an audit checks whether the factory has the process to keep them. The audit verifies materials handling, production control, laboratory testing and traceability — the four zones that determine whether a shipped batch matches the approved sample.',
      },
    },
    {
      '@type': 'Question',
      name: 'What are the four zones of a battery factory audit?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Materials in (lead, acid, separators, incoming inspection), production control (paste mixing, grid casting, plate curing, assembly, formation), laboratory testing (capacity, CCA, and reliability testing equipment that is actually used), and traceability (batch codes, records linking materials to finished batteries).',
      },
    },
    {
      '@type': 'Question',
      name: 'What documents should a battery supplier produce during an audit?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Quality system certificates (such as ISO 9001, and IATF 16949 for automotive supply), product test reports naming the standard and pass criterion, calibration records for test equipment, batch traceability records, and evidence of hazardous-cargo compliance for shipping. The absence of test reports after repeated requests is a finding in itself.',
