  isPartOf: { '@id': 'https://worldbatteryhub.com/#website' },
};

const faqJsonLd = {
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Why do two battery quotes for the "same" battery differ in price?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Usually because they are not for the same thing. The differences hide in the test standard of the CCA figure, the discharge rate of the Ah figure, the chemistry (flooded vs EFB vs AGM), the Incoterm, the payment terms, the warranty and the freight. Normalizing these fields usually closes most of the gap — the rest is supplier margin.',
      },
    },
    {
      '@type': 'Question',
      name: 'What fields must be normalized before comparing battery prices?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'At minimum: group size and terminals, CCA test standard, Ah discharge rate, chemistry, quantity and MOQ, Incoterm, payment terms, warranty length and pro-rating, packaging, certification, and freight to the same destination. Only then are unit prices comparable.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which Incoterms are common in battery imports?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'EXW (buyer takes all risk from the factory gate), FOB (seller clears export, risk transfers at the vessel), CIF (seller pays freight and insurance to the destination port) and DDP (seller delivers duty-paid). Batteries are heavy and hazardous-classed, so the freight and duty split between Incoterms is a large share of landed cost.',
      },
